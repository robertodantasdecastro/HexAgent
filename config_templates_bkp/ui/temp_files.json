{
  "temp_directory": "~/.hexagent-gui/temp",
  "session_tracking": true,
  "auto_cleanup": false,
  "prompt_on_exit": true,
  "default_save_location": "~/Documents/HexAgent",
  "file_extensions": {
    "code": [".py", ".js", ".jsx", ".sh", ".c", ".cpp", ".java", ".go", ".rs"],
    "config": [".json", ".yaml", ".yml", ".toml", ".ini", ".conf"],
    "log": [".log", ".txt"],
    "readme": [".md", ".txt", ".rst"],
    "data": [".csv", ".json", ".xml", ".sql"]
  },
  "exclusions": {
    "auto_save_extensions": [".tmp", ".swp", ".bak"],
    "ignored_directories": ["node_modules", ".git", "__pycache__"]
  },
  "retention": {
    "keep_session_files_days": 7,
    "max_temp_size_mb": 500
  }
}
